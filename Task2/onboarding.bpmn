      <bpmndi:BPMNShape id="e_startimp_di" bpmnElement="e_startimp">
        <dc:Bounds x="1800" y="1530" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1760" y="1571" width="116" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_import_di" bpmnElement="e_import">
        <dc:Bounds x="1890" y="1505" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_reply_di" bpmnElement="e_reply">
        <dc:Bounds x="2100" y="1505" width="140" height="80" />
