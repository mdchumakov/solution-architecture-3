<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_VitaStore" targetNamespace="https://vitastore.example/onboarding">
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Pool_Store" name="Магазин · сотрудник / Store Ops" processRef="Process_Store" />
    <bpmn:participant id="Pool_Platform" name="Платформа подключения · автоматизация" processRef="Process_Platform" />
    <bpmn:participant id="Pool_Human" name="Товаровед HQ · человек" processRef="Process_Human" />
    <bpmn:participant id="Pool_AI" name="ИИ-сервис · кандидаты SKU" processRef="Process_AI" />
    <bpmn:participant id="Pool_ERP" name="SAP ERP · каталог и импорт" processRef="Process_ERP" />
    <bpmn:messageFlow id="m_upload" sourceRef="s_upload" targetRef="p_start" name="CSV/XLS + store_id" />
    <bpmn:messageFlow id="m_error" sourceRef="p_error" targetRef="s_error" name="Список ошибок" />
    <bpmn:messageFlow id="m_catreq" sourceRef="p_catalog" targetRef="e_startcat" name="Запрос эталонных SKU" />
    <bpmn:messageFlow id="m_catresp" sourceRef="e_cat" targetRef="p_catalog" name="Каталог + версия" />
    <bpmn:messageFlow id="m_matchreq" sourceRef="p_match" targetRef="a_start" name="Исходные SKU + каталог" />
    <bpmn:messageFlow id="m_matchresp" sourceRef="a_send" targetRef="p_match" name="Кандидаты + оценки" />
    <bpmn:messageFlow id="m_review" sourceRef="p_review" targetRef="h_start" name="Исключения + выборка" />
    <bpmn:messageFlow id="m_decision" sourceRef="h_send" targetRef="p_answer" name="Принять / исправить" />
    <bpmn:messageFlow id="m_import" sourceRef="p_import" targetRef="e_startimp" name="Связи SKU + batch_id + версия" />
    <bpmn:messageFlow id="m_importresp" sourceRef="e_reply" targetRef="p_import" name="Статус ERP + пакет цен / ошибки" />
    <bpmn:messageFlow id="m_settings" sourceRef="p_publish" targetRef="s_config" name="Каталог + настройки" />
    <bpmn:messageFlow id="m_open" sourceRef="s_send" targetRef="p_ready" name="Акт проверки" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Store" isExecutable="false">
    <bpmn:startEvent id="s_start" name="Точка готова" />
    <bpmn:userTask id="s_upload" name="Загрузить CSV/XLS" />
    <bpmn:eventBasedGateway id="s_wait" name="Ожидать ответ" />
    <bpmn:intermediateCatchEvent id="s_error" name="Ошибки файла">
      <bpmn:messageEventDefinition id="s_error_message" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="s_fix" name="Исправить файл" />
    <bpmn:intermediateCatchEvent id="s_config" name="Пакет настроек">
      <bpmn:messageEventDefinition id="s_config_message" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="s_test" name="Загрузить пакет; проверить кассу" />
    <bpmn:exclusiveGateway id="s_ok" name="Проверка пройдена?" />
    <bpmn:userTask id="s_repair" name="Устранить сбой" />
    <bpmn:sendTask id="s_send" name="Подтвердить открытие" />
    <bpmn:endEvent id="s_end" name="Открыт" />
    <bpmn:sequenceFlow id="f_0" sourceRef="s_start" targetRef="s_upload" />
    <bpmn:sequenceFlow id="f_1" sourceRef="s_upload" targetRef="s_wait" />
    <bpmn:sequenceFlow id="f_2" sourceRef="s_config" targetRef="s_test" />
    <bpmn:sequenceFlow id="f_3" sourceRef="s_test" targetRef="s_ok" />
    <bpmn:sequenceFlow id="f_4" sourceRef="s_send" targetRef="s_end" />
    <bpmn:sequenceFlow id="s_wait_error" sourceRef="s_wait" targetRef="s_error" />
    <bpmn:sequenceFlow id="s_fix_flow" sourceRef="s_error" targetRef="s_fix" />
    <bpmn:sequenceFlow id="s_retry" sourceRef="s_fix" targetRef="s_upload" />
    <bpmn:sequenceFlow id="s_wait_config" sourceRef="s_wait" targetRef="s_config" />
    <bpmn:sequenceFlow id="s_pass" sourceRef="s_ok" targetRef="s_send" name="Да" />
    <bpmn:sequenceFlow id="s_fail" sourceRef="s_ok" targetRef="s_repair" name="Нет" />
    <bpmn:sequenceFlow id="s_retest" sourceRef="s_repair" targetRef="s_test" />
  </bpmn:process>
  <bpmn:process id="Process_Platform" isExecutable="false">
    <bpmn:startEvent id="p_start" name="Файл получен">
      <bpmn:messageEventDefinition id="p_start_message" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="p_validate" name="Проверить формат и дубли" />
    <bpmn:exclusiveGateway id="p_valid" name="Файл корректен?" />
    <bpmn:sendTask id="p_error" name="Вернуть ошибки" />
    <bpmn:endEvent id="p_badend" name="Загрузка отклонена" />
    <bpmn:serviceTask id="p_catalog" name="Запросить каталог ERP" />
    <bpmn:serviceTask id="p_match" name="Получить кандидатов ИИ" />
    <bpmn:businessRuleTask id="p_rules" name="Применить пороги и правила" />
    <bpmn:sendTask id="p_review" name="Передать исключения и выборку" />
    <bpmn:receiveTask id="p_answer" name="Получить решение товароведа" />
    <bpmn:exclusiveGateway id="p_approved" name="Пакет принят?" />
    <bpmn:serviceTask id="p_import" name="Импортировать в ERP; получить статус" />
    <bpmn:exclusiveGateway id="p_imported" name="ERP приняла?" />
    <bpmn:serviceTask id="p_rework" name="Сохранить исправления; обновить пакет" />
    <bpmn:sendTask id="p_publish" name="Отправить пакет на кассу" />
    <bpmn:receiveTask id="p_ready" name="Получить акт проверки" />
    <bpmn:endEvent id="p_end" name="Подключение завершено" />
    <bpmn:sequenceFlow id="f_5" sourceRef="p_start" targetRef="p_validate" />
    <bpmn:sequenceFlow id="f_6" sourceRef="p_validate" targetRef="p_valid" />
    <bpmn:sequenceFlow id="f_7" sourceRef="p_catalog" targetRef="p_match" />
    <bpmn:sequenceFlow id="f_8" sourceRef="p_match" targetRef="p_rules" />
    <bpmn:sequenceFlow id="f_9" sourceRef="p_rules" targetRef="p_review" />
    <bpmn:sequenceFlow id="f_10" sourceRef="p_review" targetRef="p_answer" />
    <bpmn:sequenceFlow id="f_11" sourceRef="p_answer" targetRef="p_approved" />
    <bpmn:sequenceFlow id="f_12" sourceRef="p_import" targetRef="p_imported" />
    <bpmn:sequenceFlow id="f_13" sourceRef="p_publish" targetRef="p_ready" />
    <bpmn:sequenceFlow id="f_14" sourceRef="p_ready" targetRef="p_end" />
    <bpmn:sequenceFlow id="p_invalid" sourceRef="p_valid" targetRef="p_error" name="Нет" />
    <bpmn:sequenceFlow id="p_error_end" sourceRef="p_error" targetRef="p_badend" />
    <bpmn:sequenceFlow id="p_valid_yes" sourceRef="p_valid" targetRef="p_catalog" name="Да" />
    <bpmn:sequenceFlow id="p_approved_yes" sourceRef="p_approved" targetRef="p_import" name="Да" />
    <bpmn:sequenceFlow id="p_approved_no" sourceRef="p_approved" targetRef="p_rework" name="Нет" />
    <bpmn:sequenceFlow id="p_import_yes" sourceRef="p_imported" targetRef="p_publish" name="Да" />
    <bpmn:sequenceFlow id="p_import_no" sourceRef="p_imported" targetRef="p_rework" name="Нет" />
    <bpmn:sequenceFlow id="p_again" sourceRef="p_rework" targetRef="p_catalog" />
  </bpmn:process>
  <bpmn:process id="Process_Human" isExecutable="false">
    <bpmn:startEvent id="h_start" name="Пакет на проверку">
      <bpmn:messageEventDefinition id="h_start_message" />
    </bpmn:startEvent>
    <bpmn:userTask id="h_review" name="Проверить исключения и выборку" />
    <bpmn:sendTask id="h_send" name="Вернуть решение и исправления" />
    <bpmn:endEvent id="h_end" name="Решение отправлено" />
    <bpmn:sequenceFlow id="f_15" sourceRef="h_start" targetRef="h_review" />
    <bpmn:sequenceFlow id="f_16" sourceRef="h_review" targetRef="h_send" />
    <bpmn:sequenceFlow id="f_17" sourceRef="h_send" targetRef="h_end" />
  </bpmn:process>
  <bpmn:process id="Process_AI" isExecutable="false">
    <bpmn:startEvent id="a_start" name="Запрос">
      <bpmn:messageEventDefinition id="a_start_message" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="a_match" name="Сопоставить с каталогом" />
    <bpmn:sendTask id="a_send" name="Вернуть кандидатов и оценки" />
    <bpmn:endEvent id="a_end" name="Ответ" />
    <bpmn:sequenceFlow id="f_18" sourceRef="a_start" targetRef="a_match" />
    <bpmn:sequenceFlow id="f_19" sourceRef="a_match" targetRef="a_send" />
    <bpmn:sequenceFlow id="f_20" sourceRef="a_send" targetRef="a_end" />
  </bpmn:process>
  <bpmn:process id="Process_ERP" isExecutable="false">
    <bpmn:startEvent id="e_startcat" name="Запрос каталога">
      <bpmn:messageEventDefinition id="e_startcat_message" />
    </bpmn:startEvent>
    <bpmn:sendTask id="e_cat" name="Вернуть версию каталога" />
    <bpmn:endEvent id="e_endcat" name="Каталог выдан" />
    <bpmn:startEvent id="e_startimp" name="Пакет соответствий">
      <bpmn:messageEventDefinition id="e_startimp_message" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="e_import" name="Проверить версию; импорт по batch_id" />
    <bpmn:sendTask id="e_reply" name="Статус + цены либо ошибки" />
    <bpmn:endEvent id="e_endimp" name="Ответ ERP" />
    <bpmn:sequenceFlow id="f_21" sourceRef="e_startcat" targetRef="e_cat" />
    <bpmn:sequenceFlow id="f_22" sourceRef="e_cat" targetRef="e_endcat" />
    <bpmn:sequenceFlow id="f_23" sourceRef="e_startimp" targetRef="e_import" />
    <bpmn:sequenceFlow id="f_24" sourceRef="e_import" targetRef="e_reply" />
    <bpmn:sequenceFlow id="f_25" sourceRef="e_reply" targetRef="e_endimp" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="Pool_Store_di" bpmnElement="Pool_Store" isHorizontal="true">
        <dc:Bounds x="40" y="80" width="3020" height="270" />
      </bpmndi:BPMNShape>
